# Backend runtime variables
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
CORS_ORIGINS=https://shop.example.com

# Generate each value separately and never rotate it while encrypted data exists.
# AES keys must be 64 hex characters or base64 encoding of exactly 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GIFT_ENCRYPTION_KEY=PASTE_A_DISTINCT_32_BYTE_BASE64_KEY
INVENTORY_ENCRYPTION_KEY=PASTE_A_DIFFERENT_32_BYTE_BASE64_KEY
# These two secrets accept random strings of at least 32 characters.
ORDER_LOOKUP_SECRET=PASTE_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DELIVERY_ENCRYPTION_KEY=PASTE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
ADMIN_EMAILS=admin@example.com

BANK_ID=
BANK_NAME=
ACCOUNT_NO=
ACCOUNT_NAME=

ENABLE_CHECKOUT=false
ENABLE_PAYMENT_SIMULATION=false
ENABLE_DEMO_SEED=false
TRUST_PROXY_HOPS=0
TRUST_CLOUDFLARE_HEADERS=false

# Frontend build variables
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com

  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "test:commerce": "npm run build && node ../tools/test-commerce-foundation.mjs",
    "start": "node dist/main",
    "start:local": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed:chatgpt": "node scripts/seed-chatgpt.mjs",
    "seed:reference:dry": "node scripts/seed-reference-catalog.mjs",
    "seed:reference": "node scripts/seed-reference-catalog.mjs --apply",
    "catalog:sync:dry": "node scripts/sync-public-catalog.mjs",
    "catalog:sync": "node scripts/sync-public-catalog.mjs --apply",
    "catalog:cleanup:dry": "node scripts/cleanup-catalog.mjs",
    "catalog:cleanup": "node scripts/cleanup-catalog.mjs --apply"

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Required. Keep the real value in .env or the deployment secret manager.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/lndhub

# Optional. Leave empty on normal servers. Useful behind Cloudflare WARP.
DNS_SERVERS=
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=1500
DB_CONNECT_TIMEOUT_MS=10000

# Comma-separated frontend origins. Set the deployed LNDHub URL in production.
CORS_ORIGINS=http://localhost:3000

# Reverse proxy settings. Keep 0/false unless the backend origin is protected
# behind the configured Cloudflare proxy/tunnel.
TRUST_PROXY_HOPS=0
TRUST_CLOUDFLARE_HEADERS=false

# Google OAuth 2.0 Web Client ID. Use the same value in the frontend.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
ADMIN_EMAILS=admin@example.com

# Payment recipient. Checkout stays disabled until the payment phase is approved.
BANK_ID=
BANK_NAME=
ACCOUNT_NO=
ACCOUNT_NAME=

# Keep disabled until the payment flow is reviewed and approved.
ENABLE_CHECKOUT=false
ENABLE_PAYMENT_SIMULATION=false
ENABLE_DEMO_SEED=false

# At least 32 random characters. Used to create private order lookup tokens.
ORDER_LOOKUP_SECRET=

# Required before importing or claiming free gifts. Generate once and keep it stable:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GIFT_ENCRYPTION_KEY=

# Separate 32-byte key for paid inventory. If omitted, GIFT_ENCRYPTION_KEY is
# used temporarily for compatibility; production should set a distinct key.
INVENTORY_ENCRYPTION_KEY=

# Separate key for encrypting content delivered to paid orders.
DELIVERY_ENCRYPTION_KEY=
